# Copy to .env.local and fill in only what you need.
# The app runs with NO variables set: both features stay off and the in-memory
# backend is used, which is the default development setup.

# ---------- Data backend ----------
# memory (default) | supabase
DATA_BACKEND=memory

# Required only when DATA_BACKEND=supabase.
# Tables start empty (no seed rows): create your first account through /login.
# The publishable (anon) key drives Supabase Auth sign-in/sign-up cookies; the
# service role key is server-only and must never be exposed to the browser.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- AI moderator (optional) ----------
# The AI features switch on automatically when AI_API_KEY is set (no code edit needed).
# With no key the app uses mock responses and makes no external calls.
# Set ENABLE_AI_MODERATOR=false to force them off even when a key is present.
# The provider is OpenAI-compatible: point AI_BASE_URL at any /v1 server.
# OpenRouter (https://openrouter.ai) is the recommended free option.
# AI_API_KEY=
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=openrouter/free
# With no AI_BASE_URL the client falls back to OpenAI (https://api.openai.com/v1).
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# Older OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL names are still accepted.

# ---------- Zoom (optional) ----------
# Also set ENABLE_ZOOM_API: true in config/features.ts.
# Create a Server-to-Server OAuth app in the Zoom App Marketplace.
# ZOOM_ACCOUNT_ID=...
# ZOOM_CLIENT_ID=...
# ZOOM_CLIENT_SECRET=...
